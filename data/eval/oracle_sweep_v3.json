{
  "tool": "files/oracle_sweep_v3.py",
  "command": "uv run python files/oracle_sweep_v3.py",
  "pre_registered_threshold_pp": 0.5,
  "pre_registration": "GATES.md decisions log 2026-10-29, recorded before any v3 number existed: the trigger is RECOMMENDED as an opt-in scenario field (defaults never change canonical logs) iff the best eps critical-seat family (eps_leader_6sat or eps_downlink_6sat) shows a trigger gain >= 0.5 pp on the PINNED metric (NOMINAL-only seats; same threshold and rationale as the 2026-10-03 and 2026-10-26 pre-registrations) AND its mean-coverage gain over the reactive baseline is >= 0 (no-harm check at mission level). Otherwise the mechanism ships measured-but-unrecommended and the Gate-2 CUT verdict stands for the control-loop default. Known caveat carried into every report of these numbers: the pinned metric counts the still-functional fade window as outage; the functional metric (NOMINAL or DEGRADED counts as held) is reported alongside.",
  "t_settle_s": 0.0,
  "t_settle_rule": "first tick of data/logs/nominal.jsonl whose coverage is within +/-10% (relative) of that log's mean tick coverage; fallback = v1's t_settle=0.0 (files/oracle_sweep.py:93)",
  "cap_rule": "L_effective = max(0, t_f_min - t_settle) when below the nominal L (ENDGAME_PLAN 7; v1 logic, files/oracle_sweep.py:102-107); every v3 scenario schedules exactly one failure, so per-failure capping and t_f_min capping coincide; the degrade_trigger policy has no L and is never capped",
  "metric": "critical_seat_frac = fraction of tick lines where BOTH unique critical seats (leader, downlink) are held by a status-NOMINAL satellite (PINNED); critical_seat_frac_functional = same but NOMINAL-or-DEGRADED counts as held; coverage_mean = mean tick-line coverage; gain_pp / gain_pp_functional / gain_pp_coverage = each metric minus the reactive L=0 baseline of the same scenario, x100",
  "l_grid_s": [
    0.0,
    30.0,
    60.0,
    300.0,
    600.0,
    900.0,
    1200.0,
    1800.0
  ],
